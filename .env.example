# Agora credentials (Required)
# Found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=
# Found in Agora Console → your project → "App Certificate" (Server-side only)
NEXT_AGORA_APP_CERTIFICATE=

# Pinecone credentials (Server-side only, optional for local mock)
PINECONE_API_KEY=
PINECONE_INDEX=

# OpenAI credentials (Server-side only, optional for local mock)
OPENAI_API_KEY=

# HubSpot CRM credentials (Server-side only)
# Private App Access Token for CRM lead synchronization
HUBSPOT_ACCESS_TOKEN=

# Google Calendar & Google Meet OAuth (Server-side only)
# OAuth 2.0 Web Application credentials from Google Cloud Console
# Scope required: https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Target Calendar ID (defaults to 'primary' if omitted)
GOOGLE_CALENDAR_ID=
